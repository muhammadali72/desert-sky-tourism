Options -Indexes
DirectoryIndex index.php
RewriteEngine On
RewriteCond %{HTTP_HOST} ^www\.desertskytourism\.com$ [NC,OR]
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://desertskytourism.com%{REQUEST_URI} [R=301,L,NE]
RewriteRule ^(?:wp-sitemap(?:-[^/]+)?|sitemap_index|(?:post|page|st_tour|st_location)-sitemap)\.xml$ https://desertskytourism.com/sitemap.xml [R=301,L]
RewriteRule (^|/)\.(?!well-known(?:/|$)) - [F,L]
RewriteRule (^|/)(wp-config\.php|.*\.(sql|sqlite|zip|bak))$ - [F,L,NC]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [L,QSA]
<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>
<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType image/webp "access plus 30 days"
ExpiresByType image/png "access plus 30 days"
ExpiresByType font/woff2 "access plus 1 year"
ExpiresByType text/css "access plus 1 day"
ExpiresByType application/javascript "access plus 1 day"
</IfModule>
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json application/xml
</IfModule>
